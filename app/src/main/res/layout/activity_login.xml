<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F8F9FA"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="InduSave"
        android:textColor="#0D6EFD"
        android:textSize="38sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Optimización de Merma e Inventario"
        android:textColor="#6C757D"
        android:textSize="14sp"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/et_user"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Código de Operario / Admin"
        android:inputType="text"
        android:background="@android:drawable/editbox_background"
        android:paddingLeft="15dp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/et_pass"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Contraseña de Seguridad"
        android:inputType="textPassword"
        android:background="@android:drawable/editbox_background"
        android:paddingLeft="15dp"
        android:layout_marginBottom="28dp" />

    <Button
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="AUTENTICAR INGRESO"
        android:backgroundTint="#0D6EFD"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>